# --- Kontrol Merkezi'nin KENDİ veritabanı (Supabase projesi B / herhangi bir Postgres) ---
DATABASE_URL=postgresql://postgres:<parola>@db.<proje-b>.supabase.co:5432/postgres

# Oturum çerezini imzalamak için (openssl rand -hex 32). Sistem 1 ile PAYLAŞILMAZ.
SESSION_SECRET=

# --- Sistem 1 (Menü Platformu) köprüsü ---
MENU_API_BASE_URL=https://armenu.com
# Sistem 1'deki CONTROL_HMAC_SECRET ile AYNI değer
CONTROL_HMAC_SECRET=

# İsteğe bağlı: panele yalnız bu IP'lerden erişilsin (virgülle ayrılmış). Boşsa kontrol yok.
ADMIN_ALLOWED_IPS=

# İsteğe bağlı: veritabanı bağlantı havuzu boyutu (varsayılan 3)
DB_POOL_MAX=
