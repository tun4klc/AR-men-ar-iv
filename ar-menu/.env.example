# --- Supabase projesi A (yalnızca Menü Platformu) ---
NEXT_PUBLIC_SUPABASE_URL=https://<proje>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable anahtar>
NEXT_PUBLIC_SITE_URL=https://armenu.com

# --- Kontrol Merkezi köprüsü (Sistem 2 ile paylaşılan TEK sır) ---
# openssl rand -hex 32
CONTROL_HMAC_SECRET=
# control_api rolüyle doğrudan Postgres bağlantısı (yalnız 3 fonksiyon çalıştırabilir)
# Supabase pooler: postgresql://control_api.<proje-ref>:<parola>@aws-0-<bölge>.pooler.supabase.com:6543/postgres
CONTROL_DATABASE_URL=
# İsteğe bağlı: virgülle ayrılmış izinli IP'ler (Sistem 2'nin çıkış IP'leri). Boşsa kontrol yok.
CONTROL_ALLOWED_IPS=

# --- Anlık kill-switch önbelleği (Vercel Global/Edge Config) — isteğe bağlı ama önerilir ---
# Okuma: Vercel'in otomatik eklediği bağlantı dizesi
EDGE_CONFIG=
# Yazma: Vercel REST API
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# --- İşlem e-postaları (Resend) — işletme askıya alınınca sahibine bildirim ---
# Tanımlı değilse e-posta gönderilmez, askıya alma yine çalışır.
RESEND_API_KEY=
# Doğrulanmış alan adınızdan gönderen adres, ör: AR Menü <bildirim@armenu.com>
MAIL_FROM=
# İsteğe bağlı: yanıtların gideceği destek adresi
SUPPORT_EMAIL=

# Menü çevirileri (Almanca, Rusça, Arapça, İngilizce) için Claude API anahtarı.
# Tanımlı değilse menü Türkçe/İngilizce gösterilir, panel kaydı yine çalışır.
ANTHROPIC_API_KEY=<anthropic api anahtarı>
